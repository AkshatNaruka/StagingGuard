# Local rehearsal; these are application settings, not an AgntID API contract.
PORT=8787
TRANSPORT=http
DEMO_AGENT_ID=support-agent
DEMO_TASK_ID=reply-to-t100
DEMO_TENANT_ID=acme
DEMO_TICKET_IDS=T100
DEMO_TASK_TTL_SECONDS=300

# Copy the exact governed Streamable HTTP MCP URL from your authenticated AgntID
# workspace. No endpoint, token format, or header is assumed by this starter.
AGNTID_MCP_URL=http://127.0.0.1:18082/mcp
# Trusted application identity for SDK smoke tests, never model-produced IDs.
AGNTID_AGENT_ID=hackathon-smoke-agent
AGNTID_USER_ID=local-smoke-user
# Only needed when the runtime requires OAuth; enter it locally if documented.
AGNTID_ACCESS_TOKEN=
# Fill only if the Quick Start explicitly specifies this header/credential.
# Otherwise leave both blank (e.g. browser OAuth needs its documented client flow).
AGNTID_AUTH_HEADER=
AGNTID_AUTH_VALUE=
